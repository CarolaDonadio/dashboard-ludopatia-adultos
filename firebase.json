{
	"firestore": {
		"rules": "firestore.secure.rules"
	},
	"hosting": {
		"public": "public",
		"cleanUrls": true,
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"rewrites": [
			{ "source": "/encuesta", "destination": "/survey.html" },
			{ "source": "/login", "destination": "/login.html" },
			{ "source": "/dashboard", "destination": "/dashboard.html" }
		]
	}
}
